{
    "background": {
        "scripts": [
            "background.js"
        ],
        "service_worker": "background.js",
        "type": "module"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "cnc-test@joseph.local",
            "strict_min_version": "109.0"
        }
    },
    "content_scripts": [
        {
            "js": [
                "content.js"
            ],
            "matches": [
                "*://*.alliances.commandandconquer.com/*"
            ],
            "run_at": "document_end",
            "world": "MAIN"
        }
    ],
    "description": "Simple test add-on for Command & Conquer Tiberium Alliances.",
    "host_permissions": [
        "http://localhost:3000/*",
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*"
    ],
    "manifest_version": 3,
    "name": "C&C Test Add-on",
    "permissions": [
        "storage"
    ],
    "version": "1.0"
}